{
  "private": true,
  "name": "tor-ts-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "eslint-import-resolver-typescript": "^3",
    "eslint-plugin-import": "^2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "yarn workspace tor dev",
    "test": "yarn workspaces foreach -A run test",
    "typecheck": "yarn workspace tor typecheck && yarn workspace snowflake typecheck && yarn workspace browser typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.js,.cjs",
    "lint:fix": "yarn lint --fix",
    "import:check": "yarn workspace tor import:check",
    "test:dev": "yarn workspace tor test:dev",
    "test:live": "yarn workspaces foreach -A run test:live"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
